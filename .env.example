# Base64-encoded HMAC key, at least 32 bytes (generate: openssl rand -base64 32)
AUTH_JWT_SECRET=REPLACE_WITH_A_GENERATED_BASE64_SECRET
# Access token and access cookie lifetime, in minutes
AUTH_ACCESS_TTL=15m
# Set to false only for local HTTP testing outside localhost
AUTH_COOKIE_SECURE=true
# Allowed frontend origins, comma-separated, never *
AUTH_CORS_ORIGINS=http://localhost:5173
# Spring cron (second minute hour day month weekday): every day at 03:00
AUTH_CLEANUP_CRON=0 0 3 * * *
# Expired refresh tokens are deleted this many days after expiry
AUTH_REFRESH_RETENTION=3d
#Refresh tokens time to live
AUTH_REFRESH_TTL=7d
#Maximum failure for an account
AUTH_LOGIN_MAXFAILURE=5
#Maximum failure for an Ip
AUTH_LOGIN_MAXIPFAILURE=20
#Block time on failure
AUTH_LOGIN_WINDOW=15m