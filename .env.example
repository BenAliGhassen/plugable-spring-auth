# Copy this file to .env and adjust the values. Never commit .env.
# Durations take a unit: s, m, h or d (for example 30s, 15m, 1h, 7d).
# A number without a unit is read as MILLISECONDS.

# REQUIRED. Base64-encoded HMAC key, at least 32 bytes.
# Generate one with: openssl rand -base64 32
AUTH_JWT_SECRET=REPLACE_WITH_A_GENERATED_BASE64_SECRET

# REQUIRED. Allowed frontend origins, comma-separated, never *.
# Set it to your own origin even when the frontend is served by the API itself.
AUTH_CORS_ORIGINS=http://localhost:5173

# Access token and access cookie lifetime (duration)
AUTH_ACCESS_TTL=15m

# Refresh token and refresh cookie lifetime (duration). Must be longer than AUTH_ACCESS_TTL.
AUTH_REFRESH_TTL=7d

# How long expired refresh tokens are kept before deletion (duration, greater than zero)
AUTH_REFRESH_RETENTION=3d

# Cleanup schedule (Spring cron: second minute hour day month weekday). Default: every day at 03:00
AUTH_CLEANUP_CRON=0 0 3 * * *

# Secure flag on the auth cookies. Set to false only for local HTTP testing outside localhost.
AUTH_COOKIE_SECURE=true

# Failed logins allowed per IP + username before that pair is blocked
AUTH_LOGIN_MAXFAILURE=5

# Failed logins allowed per IP, across all usernames. Must be greater than AUTH_LOGIN_MAXFAILURE.
AUTH_LOGIN_MAXIPFAILURE=20

# How long failures are counted, and how long a block lasts after the last failure (duration)
AUTH_LOGIN_WINDOW=15m